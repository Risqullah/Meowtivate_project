<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="15dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- NAMA, KATEGORI, DAN TOMBOL HAPUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecordName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:text="Jalan Pagi"
                android:textColor="@color/navy"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRecordCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Langkah"
                android:textColor="@color/coral"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteRecord"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Hapus"
                android:textAllCaps="false"
                android:textColor="@color/coral_dark"
                android:textSize="10sp"
                app:backgroundTint="@color/soft_red"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- JUMLAH AKTIVITAS -->
        <TextView
            android:id="@+id/tvRecordAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_bold"
            android:text="2.500 langkah"
            android:textColor="@color/navy"
            android:textSize="18sp" />

        <!-- WAKTU PENCATATAN -->
        <TextView
            android:id="@+id/tvRecordDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_regular"
            android:text="15 Nov 2026, 10:30"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
