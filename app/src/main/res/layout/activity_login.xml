<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="92dp"
        android:paddingBottom="24dp">

        <!-- LOGO ASLI DARI FIGMA -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/meowtivate_mark_rmbg"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Meowtivate" />

        <!-- NAMA APLIKASI -->
        <TextView
            android:id="@+id/tvAppName"
            style="@style/TextAppearance.Meowtivate.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Meowtivate"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:gravity="center" />

        <!-- FORM LOGIN DALAM CARDVIEW -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/navy_secondary"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- USERNAME -->
            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/bg_login_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/inter_regular"
                android:hint="Username"
                android:inputType="text"
                android:singleLine="true"
                android:autofillHints="username"
                android:textColor="@color/navy"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <!-- PASSWORD -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/inter_regular"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:autofillHints="password"
                android:textColor="@color/navy"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <!-- TOMBOL LOGIN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="30dp"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                app:backgroundTint="@color/coral"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- REGISTRASI TANPA KOTAK -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:minHeight="0dp"
                android:text="Registrasi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                app:backgroundTint="@color/navy"
                app:rippleColor="@android:color/transparent"
                app:cornerRadius="0dp"
                app:strokeWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>


</androidx.core.widget.NestedScrollView>
