<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="Riwayat &amp; Statistik"
            android:textColor="@color/navy"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_regular"
            android:text="Lihat perkembangan kebiasaanmu."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- PERIODE STATISTIK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_steps_icon"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="7 HARI TERAKHIR"
            android:textColor="@color/green"
            android:textSize="9sp" />

        <!-- KARTU GRAFIK LANGKAH -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Langkah kaki"
                    android:textColor="@color/navy"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Tren aktivitas selama satu minggu"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="32.450 langkah"
                    android:textColor="@color/navy"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Total langkah minggu ini"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <!-- GRAFIK 7 HARI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <!-- SENIN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_chart_track">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_gravity="bottom"
                                android:background="@color/green" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Sen"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- SELASA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_chart_track">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_gravity="bottom"
                                android:background="@color/green" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Sel"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- RABU -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_chart_track">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:layout_gravity="bottom"
                                android:background="@color/green" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Rab"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- KAMIS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_chart_track">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="65dp"
                                android:layout_gravity="bottom"
                                android:background="@color/green" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Kam"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- JUMAT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_chart_track">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_gravity="bottom"
                                android:background="@color/green" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Jum"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- SABTU -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_chart_bar_coral">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:layout_gravity="bottom"
                                android:background="@color/coral" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Sab"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- MINGGU -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_chart_track">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_gravity="bottom"
                                android:background="@color/green" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Min"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- RINGKASAN AIR DAN TIDUR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- AIR PUTIH -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="15dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Air putih"
                        android:textColor="@color/navy"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="1,4 L"
                        android:textColor="@color/water_blue"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Rata-rata / hari"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- DURASI TIDUR -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="15dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Durasi tidur"
                        android:textColor="@color/navy"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="6j 50m"
                        android:textColor="@color/sleep_lavender"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Rata-rata / hari"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- INSIGHT MINGGUAN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/insight_surface"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Insight mingguan"
                    android:textColor="@color/navy"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Pertahankan kebiasaan sehatmu dan terus capai target harian bersama Mochi!"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- AKTIVITAS TERBARU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Aktivitas terbaru"
            android:textColor="@color/navy"
            android:textSize="16sp" />

        <ListView
            android:id="@+id/listRecentActivities"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:listSelector="@android:color/transparent"
            android:nestedScrollingEnabled="false"
            android:scrollbars="none" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
