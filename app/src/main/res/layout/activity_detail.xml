<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipChildren="false">

    <!-- TOOLBAR TENTANG APLIKASI -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detailToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cream"
        android:elevation="0dp"
        app:title="Tentang Aplikasi"
        app:titleTextAppearance="@style/TextAppearance.Meowtivate.ToolbarTitle"
        app:titleTextColor="@color/navy"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/navy"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- KONTEN HALAMAN -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/detailToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- LOGO DAN IDENTITAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:src="@drawable/meowtivate_mark_rmbg"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo Meowtivate" />

                <TextView
                    android:id="@+id/tvProjectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Meowtivate"
                    android:textColor="@color/navy"
                    android:textSize="27sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Gamified Health &amp; Fitness Tracker"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_about_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="LANGKAH KECIL, LEVEL BARU."
                    android:textColor="@color/navy"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- AREA KARTU DAN MASKOT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/aboutCardsLayer"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- KARTU DESKRIPSI -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="1dp"
                    app:cardUseCompatPadding="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:lineSpacingExtra="3dp"
                            android:text="Meowtivate membantu mahasiswa mencatat langkah kaki, konsumsi air putih, dan durasi tidur. XP, level, dan kucing virtual 2D memberi umpan balik visual atas aktivitas serta pencapaian."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Versi konsep • Data disimpan lokal"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- KARTU TEMA PROYEK -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTheme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="1dp"
                    app:cardUseCompatPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/cardDescription"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="15dp"
                        android:paddingEnd="85dp"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Tema proyek"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvTeamName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Gaya Hidup Sehat &amp; Kebugaran"
                            android:textColor="@color/navy"
                            android:textSize="12sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- MOCHI: MENUMPANGI KEDUA KARTU -->
                <ImageView
                    android:id="@+id/ivMochiPeek"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:layout_marginTop="79dp"
                    android:translationX="16dp"
                    android:elevation="8dp"
                    android:src="@drawable/mascot_mochi_tutupmata"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Mochi mengintip dari sisi kanan"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- TOMBOL KEMBALI: DI BAWAH KARTU -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Kembali"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_semibold"
                android:textSize="14sp"
                app:backgroundTint="@color/coral"
                app:cornerRadius="12dp"
                app:insetTop="0dp"
                app:insetBottom="0dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
