<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="26dp"
    android:paddingVertical="18dp">

    <!-- LABEL HALAMAN -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_about_badge"
        android:fontFamily="@font/inter_semibold"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="03  /  GAMIFIKASI"
        android:textColor="@color/coral_dark"
        android:textSize="10sp" />

    <!-- KARTU MOCHI -->
    <androidx.cardview.widget.CardView
        android:layout_width="158dp"
        android:layout_height="158dp"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/peach"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:contentDescription="Mochi merayakan pencapaian"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_mochi_kediplove" />

    </androidx.cardview.widget.CardView>

    <!-- JUDUL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Rayakan Setiap Kemajuan"
        android:textColor="@color/navy"
        android:textSize="21sp" />

    <!-- DESKRIPSI -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Kumpulkan XP dari kebiasaan sehat, tingkatkan level Mochi, dan dapatkan pencapaian. Konsistensi kecil membawa perubahan besar!"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- KARTU XP -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/navy"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="MOCHI · LEVEL 3"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_xp_pill"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="45/100 XP"
                    android:textColor="@color/white"
                    android:textSize="9sp" />

            </LinearLayout>

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="13dp"
                android:max="100"
                android:progress="45"
                android:progressBackgroundTint="@color/xp_track"
                android:progressTint="@color/coral" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="@font/inter_regular"
                android:text="Terus kumpulkan XP bersama Mochi!"
                android:textColor="@color/peach"
                android:textSize="10sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Masuk ke Meowtivate"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:backgroundTint="@color/coral"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_login"
        app:iconTint="@color/white" />

</LinearLayout>
